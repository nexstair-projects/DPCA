{
  "name": "WF2 — Message Classification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf2-classify",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wf2-1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "wf2-classify"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/internal/classify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-internal-token", "value": "={{ $env.INTERNAL_API_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message_id: $json.body.message_id }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "wf2-2",
      "name": "Classify via Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.tier }}",
              "rightValue": 3,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf2-3",
      "name": "Tier 3?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/webhooks/n8n/tier3-alert",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-dpca-signature", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message_id: $('Webhook Trigger').item.json.body.message_id, tier: $json.tier, category: $json.category, reasoning: $json.reasoning }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "wf2-4",
      "name": "Notify Tier 3",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.category }}",
              "rightValue": "new_inquiry",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf2-5",
      "name": "New Inquiry?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [940, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE_URL }}/webhook/wf5-draft",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message_id: $('Webhook Trigger').item.json.body.message_id }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "wf2-6",
      "name": "Trigger WF5 (Draft)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE_URL }}/webhook/wf7-extract-lead",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message_id: $('Webhook Trigger').item.json.body.message_id }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "wf2-7",
      "name": "Trigger WF7 (Lead)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 500]
    },
    {
      "parameters": {},
      "id": "wf2-8",
      "name": "Done (Tier 3 - No Draft)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1180, 180]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[ { "node": "Classify via Backend", "type": "main", "index": 0 } ]]
    },
    "Classify via Backend": {
      "main": [[ { "node": "Tier 3?", "type": "main", "index": 0 } ]]
    },
    "Tier 3?": {
      "main": [
        [ { "node": "Notify Tier 3", "type": "main", "index": 0 } ],
        [ { "node": "New Inquiry?", "type": "main", "index": 0 } ]
      ]
    },
    "Notify Tier 3": {
      "main": [[ { "node": "Done (Tier 3 - No Draft)", "type": "main", "index": 0 } ]]
    },
    "New Inquiry?": {
      "main": [
        [ { "node": "Trigger WF5 (Draft)", "type": "main", "index": 0 }, { "node": "Trigger WF7 (Lead)", "type": "main", "index": 0 } ],
        [ { "node": "Trigger WF5 (Draft)", "type": "main", "index": 0 } ]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
