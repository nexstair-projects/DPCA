{
  "name": "WF8 — Dashboard Actions",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf8-dashboard-action",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wf8-1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "wf8-dashboard-action"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/internal/dashboard-action",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-internal-token", "value": "={{ $env.INTERNAL_API_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  action: $json.body.action,\n  draft_id: $json.body.draft_id,\n  message_id: $json.body.message_id,\n  user_id: $json.body.user_id,\n  instructions: $json.body.instructions,\n  rejection_reason: $json.body.rejection_reason\n}) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "wf8-2",
      "name": "Dashboard Action via Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $('Webhook Trigger').item.json.body.action }}",
              "rightValue": "regenerate",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf8-3",
      "name": "Was Regen?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.auto_send }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf8-4",
      "name": "Regen Auto-Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [940, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE_URL }}/webhook/wf6-send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ draft_id: $json.draft_id, message_id: $('Webhook Trigger').item.json.body.message_id }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "wf8-5",
      "name": "Trigger WF6 (Regen Auto-Send)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 160]
    },
    {
      "parameters": {},
      "id": "wf8-6",
      "name": "Regen Awaiting Review",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1180, 320]
    },
    {
      "parameters": {},
      "id": "wf8-7",
      "name": "Done (Approve/Reject)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [940, 420]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[ { "node": "Dashboard Action via Backend", "type": "main", "index": 0 } ]]
    },
    "Dashboard Action via Backend": {
      "main": [[ { "node": "Was Regen?", "type": "main", "index": 0 } ]]
    },
    "Was Regen?": {
      "main": [
        [ { "node": "Regen Auto-Send?", "type": "main", "index": 0 } ],
        [ { "node": "Done (Approve/Reject)", "type": "main", "index": 0 } ]
      ]
    },
    "Regen Auto-Send?": {
      "main": [
        [ { "node": "Trigger WF6 (Regen Auto-Send)", "type": "main", "index": 0 } ],
        [ { "node": "Regen Awaiting Review", "type": "main", "index": 0 } ]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
