{
  "name": "WF6 — Auto-Send Gmail",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf6-send",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wf6-1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "wf6-send"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL }}/api/drafts/={{ $json.body.draft_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.INTERNAL_API_TOKEN }}" }
          ]
        },
        "options": { "timeout": 15000 }
      },
      "id": "wf6-2",
      "name": "Fetch Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL }}/api/messages/={{ $('Webhook Trigger').item.json.body.message_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.INTERNAL_API_TOKEN }}" }
          ]
        },
        "options": { "timeout": 15000 }
      },
      "id": "wf6-3",
      "name": "Fetch Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 480]
    },
    {
      "parameters": {
        "jsCode": "const draft = $('Fetch Draft').item.json;\nconst message = $('Fetch Message').item.json;\n\nreturn [{\n  json: {\n    draft_id: $('Webhook Trigger').item.json.body.draft_id,\n    message_id: $('Webhook Trigger').item.json.body.message_id,\n    sender_email: draft.sender_email,\n    subject_line: draft.subject_line,\n    draft_text: draft.draft_text,\n    thread_external_id: message.thread_external_id,\n    message_id_header: message.message_id_header,\n    sender_name: message.sender_name,\n    sender_email_orig: message.sender_email,\n    cc: draft.cc || null,\n    channel: message.channel\n  }\n}];"
      },
      "id": "wf6-4",
      "name": "Merge Draft + Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 380]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.channel }}",
              "rightValue": "gmail",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf6-5",
      "name": "Gmail Channel?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [940, 380]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "reply",
        "messageId": "={{ $json.thread_external_id }}",
        "replyToSenderOnly": false,
        "sendTo": "={{ $json.sender_email_orig }}",
        "subject": "={{ $json.subject_line }}",
        "emailType": "text",
        "message": "={{ $json.draft_text }}",
        "options": {
          "appendAttribution": false,
          "ccList": "={{ $json.cc ? $json.cc.join(',') : '' }}",
          "inReplyTo": "={{ $json.message_id_header }}"
        }
      },
      "id": "wf6-6",
      "name": "Send Gmail Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1180, 260],
      "credentials": {
        "gmailOAuth2": {
          "name": "YOUR_GMAIL_CREDENTIAL_NAME"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "modify",
        "messageId": "={{ $('Merge Draft + Message').item.json.thread_external_id }}",
        "addLabelNames": ["AI-Sent"],
        "removeLabelNames": ["AI-Processing"]
      },
      "id": "wf6-7",
      "name": "Update Gmail Labels",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1420, 260],
      "credentials": {
        "gmailOAuth2": {
          "name": "YOUR_GMAIL_CREDENTIAL_NAME"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst payload = JSON.stringify({\n  draft_id: $('Merge Draft + Message').item.json.draft_id,\n  message_id: $('Merge Draft + Message').item.json.message_id,\n  success: true,\n  sent_at: new Date().toISOString()\n});\nconst sig = crypto\n  .createHmac('sha256', $env.N8N_WEBHOOK_SECRET)\n  .update(payload)\n  .digest('hex');\n\nreturn [{ json: { payload, sig } }];"
      },
      "id": "wf6-8",
      "name": "Sign Send Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1660, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/webhooks/n8n/send-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-dpca-signature", "value": "={{ $json.sig }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "otherBody",
        "body": "={{ $json.payload }}",
        "options": { "timeout": 10000 }
      },
      "id": "wf6-9",
      "name": "POST Send Result (Success)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1900, 260]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst payload = JSON.stringify({\n  draft_id: $('Merge Draft + Message').item.json.draft_id,\n  message_id: $('Merge Draft + Message').item.json.message_id,\n  success: false,\n  error_message: 'Non-Gmail channel: send not implemented'\n});\nconst sig = crypto\n  .createHmac('sha256', $env.N8N_WEBHOOK_SECRET)\n  .update(payload)\n  .digest('hex');\n\nreturn [{ json: { payload, sig } }];"
      },
      "id": "wf6-10",
      "name": "Non-Gmail Stub",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/webhooks/n8n/send-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-dpca-signature", "value": "={{ $json.sig }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "otherBody",
        "body": "={{ $json.payload }}",
        "options": { "timeout": 10000 }
      },
      "id": "wf6-11",
      "name": "POST Send Result (Stub Fail)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, 520]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          { "node": "Fetch Draft", "type": "main", "index": 0 },
          { "node": "Fetch Message", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch Draft": {
      "main": [[ { "node": "Merge Draft + Message", "type": "main", "index": 0 } ]]
    },
    "Fetch Message": {
      "main": [[ { "node": "Merge Draft + Message", "type": "main", "index": 0 } ]]
    },
    "Merge Draft + Message": {
      "main": [[ { "node": "Gmail Channel?", "type": "main", "index": 0 } ]]
    },
    "Gmail Channel?": {
      "main": [
        [ { "node": "Send Gmail Reply", "type": "main", "index": 0 } ],
        [ { "node": "Non-Gmail Stub", "type": "main", "index": 0 } ]
      ]
    },
    "Send Gmail Reply": {
      "main": [[ { "node": "Update Gmail Labels", "type": "main", "index": 0 } ]]
    },
    "Update Gmail Labels": {
      "main": [[ { "node": "Sign Send Result", "type": "main", "index": 0 } ]]
    },
    "Sign Send Result": {
      "main": [[ { "node": "POST Send Result (Success)", "type": "main", "index": 0 } ]]
    },
    "Non-Gmail Stub": {
      "main": [[ { "node": "POST Send Result (Stub Fail)", "type": "main", "index": 0 } ]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
