{
  "name": "WF5 — Draft Generation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf5-draft",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wf5-1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "wf5-draft"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/internal/generate-draft",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-internal-token", "value": "={{ $env.INTERNAL_API_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message_id: $json.body.message_id }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "wf5-2",
      "name": "Generate Draft via Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.auto_send }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf5-3",
      "name": "Auto-Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE_URL }}/webhook/wf6-send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ draft_id: $json.draft_id, message_id: $('Webhook Trigger').item.json.body.message_id }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "wf5-4",
      "name": "Trigger WF6 (Auto-Send)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 220]
    },
    {
      "parameters": {},
      "id": "wf5-5",
      "name": "Awaiting Review",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [940, 420]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[ { "node": "Generate Draft via Backend", "type": "main", "index": 0 } ]]
    },
    "Generate Draft via Backend": {
      "main": [[ { "node": "Auto-Send?", "type": "main", "index": 0 } ]]
    },
    "Auto-Send?": {
      "main": [
        [ { "node": "Trigger WF6 (Auto-Send)", "type": "main", "index": 0 } ],
        [ { "node": "Awaiting Review", "type": "main", "index": 0 } ]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
