# =============================================================
# DPCA — Dream Paris Communication Assistant
# Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env
# =============================================================

# Anthropic — Claude AI (primary LLM for classification, drafting, lead extraction, tone validation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DRAFT=claude-sonnet-4-6
ANTHROPIC_MODEL_CLASSIFY=claude-sonnet-4-6
ANTHROPIC_MODEL_TONE=claude-haiku-4-5-20251001

# Google Gemini — fallback LLM (embeddings via text-embedding-004 if GEMINI_API_KEY works)
GEMINI_API_KEY=
GEMINI_MODEL_DRAFT=gemini-2.0-flash
GEMINI_MODEL_CLASSIFY=gemini-2.0-flash
GEMINI_MODEL_TONE=gemini-2.0-flash

# OpenRouter — third LLM fallback + embedding fallback when Gemini fails
OPENROUTER_API_KEY=
OPENROUTER_MODEL_DRAFT=openai/gpt-oss-120b:free
OPENROUTER_MODEL_CLASSIFY=openai/gpt-oss-120b:free
OPENROUTER_MODEL_TONE=openai/gpt-oss-120b:free
# Free NVIDIA embedding model on OpenRouter. If you switch from Gemini permanently,
# recreate the Pinecone index at the dim that matches this model and re-run kb-import.
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# Pinecone index dimensionality. Must match the active embedding provider's output.
# Gemini text-embedding-004 = 768 | NVIDIA llama-nemotron-embed-vl-1b-v2 = 2048
EMBEDDING_DIMS=2048

# OpenAI — optional; not used for embeddings anymore. Kept for future use.
OPENAI_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pinecone (index must be 2048-dim to match NVIDIA llama-nemotron-embed-vl-1b-v2)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=dpca-knowledge-base
PINECONE_INDEX_HOST=
PINECONE_ENVIRONMENT=

# Gmail OAuth (per inbox)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Meta APIs (populated after Meta App Review approval)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_INSTAGRAM_ACCESS_TOKEN=
META_APP_SECRET=

# n8n
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_BASE_URL=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_SECRET=
# WF-to-WF trigger URLs — set to $N8N_WEBHOOK_BASE_URL/webhook/<path>
WF2_WEBHOOK_URL=
WF5_WEBHOOK_URL=
WF6_WEBHOOK_URL=
WF7_WEBHOOK_URL=
WF8_WEBHOOK_URL=

# App
NODE_ENV=development
# Backend URL as seen by n8n (Docker internal or public, e.g. http://host.docker.internal:3001)
BACKEND_URL=http://host.docker.internal:3001
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
INTERNAL_API_TOKEN=
TONE_CONFIDENCE_THRESHOLD=75
DEFAULT_OUTBOUND_INBOX_ID=