    {
      "parameters": {
        "jsCode": "function getFirstAddress(obj) {\n  if (!obj || !obj.value || !Array.isArray(obj.value) || obj.value.length === 0) return '';\n  return obj.value[0].address || '';\n}\n\nfunction getFirstName(obj) {\n  if (!obj || !obj.value || !Array.isArray(obj.value) || obj.value.length === 0) return '';\n  return obj.value[0].name || '';\n}\n\nfunction getHeaderValue(headers, key) {\n  if (!headers || typeof headers !== 'object') return '';\n  const value = headers[key.toLowerCase()];\n  if (!value) return '';\n  const idx = value.indexOf(':');\n  return idx >= 0 ? value.slice(idx + 1).trim() : value.trim();\n}\n\nreturn items.map(item => {\n  const j = item.json;\n  const fromEmail = getFirstAddress(j.from);\n  const senderName = getFirstName(j.from);\n  const messageIdHeader = j.messageId || getHeaderValue(j.headers, 'message-id') || '';\n  const inReplyTo = getHeaderValue(j.headers, 'in-reply-to') || '';\n  const subject = j.subject || getHeaderValue(j.headers, 'subject') || '';\n  const receivedAt = j.date ? new Date(j.date).toISOString() : null;\n  const bodyText = (j.text && j.text.trim()) || (j.textAsHtml && j.textAsHtml.trim()) || (j.html && j.html.trim()) || '';\n\n  return {\n    json: {\n      gmail_message_id: j.id || '',\n      gmail_thread_id: j.threadId || '',\n      message_id_header: messageIdHeader,\n      in_reply_to: inReplyTo,\n      from_email: fromEmail,\n      sender_name: senderName,\n      subject: subject,\n      received_at: receivedAt,\n      body_text: bodyText\n    }\n  };\n});"
      },
      "id": "node-4-clean-email",
      "name": "Extract Email Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-940, 0]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst sanitize = (val) => {\n  if (!val) return null;\n  return String(val)\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/\"/g, '\\\\\"')\n    .replace(/\\n/g, '\\\\n')\n    .replace(/\\r/g, '\\\\r')\n    .replace(/\\t/g, '\\\\t');\n};\n\nreturn items.map(({ json: item }) => {\n  const now = new Date().toISOString();\n  return {\n    json: {\n      inbox_id: '70eb1a2a-d50c-4586-96a2-f12a9ed57118',\n      channel: 'gmail',\n      sender_email: sanitize(item.from_email),\n      sender_name: sanitize(item.sender_name),\n      subject: sanitize(item.subject),\n      body_raw: sanitize(item.body_text),\n      body_clean: sanitize(item.body_text),\n      message_external_id: sanitize(item.gmail_message_id),\n      thread_id: sanitize(item.gmail_thread_id),\n      in_reply_to: sanitize(item.in_reply_to),\n      classification_status: 'pending',\n      status: 'received',\n      received_at: item.received_at || null,\n      created_at: now,\n      updated_at: now,\n      _gmail_id: item.gmail_message_id\n    }\n  };\n});"
      },
