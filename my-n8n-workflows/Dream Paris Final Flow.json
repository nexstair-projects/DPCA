    {
      "parameters": {
        "jsCode": "function getFirstAddress(obj) {\n  if (!obj || !obj.value || !Array.isArray(obj.value) || obj.value.length === 0) {\n    return '';\n  }\n  return obj.value[0].address || '';\n}\n\nfunction getFirstName(obj) {\n  if (!obj || !obj.value || !Array.isArray(obj.value) || obj.value.length === 0) {\n    return '';\n  }\n  return obj.value[0].name || '';\n}\n\nfunction getHeaderValue(headers, key) {\n  if (!headers || typeof headers !== 'object') return '';\n  const value = headers[key.toLowerCase()];\n  if (!value) return '';\n  const idx = value.indexOf(':');\n  return idx >= 0 ? value.slice(idx + 1).trim() : value.trim();\n}\n\nreturn items.map(item => {\n  const j = item.json;\n\n  const fromEmail = getFirstAddress(j.from);\n  const senderName = getFirstName(j.from);\n  const toEmail = getFirstAddress(j.to);\n\n  const messageIdHeader = j.messageId || getHeaderValue(j.headers, 'message-id') || '';\n  const inReplyTo = getHeaderValue(j.headers, 'in-reply-to') || '';\n\n  const subject = j.subject || getHeaderValue(j.headers, 'subject') || '';\n  const receivedAt = j.date ? new Date(j.date).toISOString() : null;\n\n  const bodyText =\n    (j.text && j.text.trim()) ||\n    (j.textAsHtml && j.textAsHtml.trim()) ||\n    (j.html && j.html.trim()) ||\n    '';\n\n  const snippet = bodyText\n    ? bodyText.replace(/\\s+/g, ' ').trim().slice(0, 500)\n    : '';\n\n  return {\n    json: {\n      gmail_message_id: j.id || '',\n      gmail_thread_id: j.threadId || '',\n      message_id_header: messageIdHeader,\n      in_reply_to: inReplyTo,\n      from_email: fromEmail,\n      sender_name: senderName,\n      to_email: toEmail,\n      subject: subject,\n      received_at: receivedAt,\n      snippet: snippet,\n      body_text: bodyText,\n      status: 'new'\n    }\n  };\n});"
      },
